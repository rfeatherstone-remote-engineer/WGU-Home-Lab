*.tfvars
*.tfvars.json
*.tfvars.lock
text.tfvars

# Local configuration overrides and developer-specific adjustments
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash dumps and structural diagnostics records
crash.log
crash.*.log

